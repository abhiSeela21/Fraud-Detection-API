FRAUD_ENVIRONMENT=development
FRAUD_DATABASE_URL=postgresql+psycopg://fraud:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/fraud
FRAUD_FRONTEND_ORIGIN=http://localhost:5173
# Explicit local HTTP exception. Production must use true.
FRAUD_COOKIE_SECURE=false
FRAUD_SESSION_TTL_HOURS=24
FRAUD_MAX_TRANSACTIONS_PER_SESSION=500
FRAUD_REQUESTS_PER_MINUTE_IP=240
FRAUD_REQUESTS_PER_MINUTE_TOKEN=180
FRAUD_SESSIONS_PER_MINUTE_IP=10
FRAUD_RATE_LIMIT_MAX_KEYS=10000
# Set only to actual reverse-proxy networks; run uvicorn with --no-proxy-headers.
FRAUD_TRUSTED_PROXY_CIDRS=[]
FRAUD_MAX_REQUEST_BYTES=32768
FRAUD_CLEANUP_BATCH_SIZE=100
FRAUD_CLEANUP_INTERVAL_SECONDS=60
